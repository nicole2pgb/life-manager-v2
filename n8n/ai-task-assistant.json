    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": { \"type\": [\"string\", \"null\"], \"description\": \"Short task name, or null if unclear\" },\n    \"type\": { \"type\": \"string\", \"enum\": [\"one_time\", \"daily\", \"times_per_week\", \"unclear\"] },\n    \"frequency\": { \"type\": [\"integer\", \"null\"], \"minimum\": 1, \"maximum\": 7, \"description\": \"Times per week, only for times_per_week\" },\n    \"date\": { \"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\", \"description\": \"YYYY-MM-DD, only for one_time\" },\n    \"clarification\": { \"type\": [\"string\", \"null\"], \"description\": \"Question for the user, only when type is unclear\" }\n  },\n  \"required\": [\"title\", \"type\", \"frequency\", \"date\", \"clarification\"],\n  \"additionalProperties\": false\n}"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [800, 440]
    },
    {
      "parameters": {
        "jsCode": "// Never trust the LLM: re-validate its output and decide the route.\n// Anything invalid becomes `unclear`, so bad data never reaches the action nodes.\nconst DEFAULT_QUESTION = 'Could you rephrase that as a task, for example \"Go to the gym tomorrow\", \"Take vitamins every day\" or \"Go to the gym 3 times a week\"?';\nconst TYPES = ['one_time', 'daily', 'times_per_week', 'unclear'];\n\nconst ai = $input.first().json.output ?? {};\n\nfunction unclear(question) {\n  return [{ json: { route: 'unclear', task: null, message: question || DEFAULT_QUESTION } }];\n}\n\nfunction isRealDate(value) {\n  if (typeof value !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) return false;\n  const [y, m, d] = value.split('-').map(Number);\n  const dt = new Date(Date.UTC(y, m - 1, d));\n  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;\n}\n\nconst question = typeof ai.clarification === 'string' && ai.clarification.trim() ? ai.clarification.trim() : null;\n\nif (!TYPES.includes(ai.type) || ai.type === 'unclear') return unclear(question);\n\nconst title = typeof ai.title === 'string' ? ai.title.trim() : '';\nif (title.length < 1 || title.length > 255) return unclear(question);\n\nlet frequency = null;\nlet date = null;\n\nif (ai.type === 'times_per_week') {\n  if (!Number.isInteger(ai.frequency) || ai.frequency < 1 || ai.frequency > 7) {\n    return unclear('How many times per week (1 to 7) should this repeat?');\n  }\n  frequency = ai.frequency;\n}\n\nif (ai.type === 'one_time' && ai.date !== null && ai.date !== undefined) {\n  if (!isRealDate(ai.date)) return unclear('Which date do you mean? Please give a specific day.');\n  date = ai.date;\n}\n// daily / times_per_week: frequency/date stay null (the app rejects dates on recurring tasks).\n\nreturn [{ json: { route: ai.type, task: { title, type: ai.type, frequency, date }, message: null } }];"
      },
