# Copy this file to .env.local and fill in your own local MySQL values.
# Never commit .env.local or real credentials.
DATABASE_URL=mysql://<user>:<password>@localhost:3306/<database>

# Optional. IANA time zone that defines "today" for every user until
# per-user time zones exist. Defaults to Europe/Berlin.
# APP_TIME_ZONE=Europe/Berlin

# Optional. Full URL of the n8n "AI Task Assistant" webhook. Server-side only
# (never NEXT_PUBLIC_). Without it the chat widget answers "not configured".
# N8N_WEBHOOK_URL=
